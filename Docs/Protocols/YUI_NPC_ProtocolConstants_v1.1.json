  "quantization": {
    "position_q14": {
      "q_min": 0,
      "q_max": 16383,
      "encode": "floor(((value-min)/(max-min))*16383+0.5)",
      "decode": "min+(q/16383)*(max-min)",
      "bounds": "wire_bounds",
      "out_of_activity_bounds": "reject"
    },
    "yaw_q14": {
      "q_min": 0,
      "q_max": 16383,
      "encode": "floor((wrap360(deg)/360)*16384+0.5) mod 16384",
      "decode": "q*360/16384",
      "zero_direction": "+Z",
      "positive_direction": "clockwise_when_viewed_from_above"
    },
    "speed_q7": {
      "q_min": 0,
      "q_max": 127,
      "encode": "floor((mps/maxSpeed)*127+0.5)",
      "decode": "q*maxSpeed/127",
      "out_of_bounds": "reject"
    },
    "weight_q7": {
      "q_min": 0,
      "q_max": 127,
      "encode": "floor(weight*127+0.5)",
      "decode": "q/127"
    },
    "centered_q7": {
      "neutral_q": 64,
      "encode_negative_or_zero": "floor(64+(value/abs(min))*64+0.5)",
      "encode_positive": "64+floor((value/max)*63+0.5)",
      "decode_q_le_64": "((q-64)/64)*abs(min)",
      "decode_q_gt_64": "((q-64)/63)*max"
    },
    "unsigned_q7": {
      "encode": "floor(((value-min)/(max-min))*127+0.5)",
      "decode": "min+(q/127)*(max-min)"
    }
  },
