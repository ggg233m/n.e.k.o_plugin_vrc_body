      { "key": "left_arm_azimuth", "cc": 25, "unit": "deg", "min": -120, "neutral": 0, "max": 120, "encoding": "centered_q7", "positive": "向 NPC 右侧" },
      { "key": "right_arm_elevation", "cc": 26, "unit": "deg", "min": 0, "neutral": 0, "max": 160, "encoding": "unsigned_q7", "positive": "由自然下垂向上抬臂" },
      { "key": "right_arm_azimuth", "cc": 27, "unit": "deg", "min": -120, "neutral": 0, "max": 120, "encoding": "centered_q7", "positive": "向 NPC 右侧" }
