      "zero_direction": "+Z",
      "positive_direction": "clockwise_when_viewed_from_above",
      "range_degrees": { "min": 0, "min_inclusive": true, "max": 360, "max_inclusive": false }
    },
    "brg": {
      "wire_field": "brg",
      "meaning": "bearing relative to current NPC forward",
      "zero_direction": "current NPC forward",
      "positive_direction": "clockwise/right_when_viewed_from_above",
      "negative_direction": "counterclockwise/left_when_viewed_from_above",
      "range_degrees": { "min": -180, "min_inclusive": false, "max": 180, "max_inclusive": true },
      "absolute_yaw_formula": "wrap360(npc_yaw_deg+brg_deg)",
      "example": { "npc_yaw_deg": 350, "brg_deg": 20, "absolute_yaw_deg": 10, "turn_to_p0_q14": 455 }
    }
  },
  "transport": {
    "midi_port": "NEKO_MIDI",
    "channels": {
      "command": 0,
      "upper_body_stream": 1,
      "text": 2
    },
    "registers": {
      "P0": { "bits": 14, "hi_cc": 20, "lo_cc": 21, "min": 0, "max": 16383 },
      "P1": { "bits": 14, "hi_cc": 22, "lo_cc": 23, "min": 0, "max": 16383 },
      "P2": { "bits": 14, "hi_cc": 24, "lo_cc": 25, "min": 0, "max": 16383 },
